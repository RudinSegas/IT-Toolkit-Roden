   <WrapPanel><Button Content="Refresh" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Collect" /><Button Content="Export results…" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="ExportSection" /></WrapPanel></StackPanel></Border>
<StackPanel Visibility="{Binding DiagnosticSearchVisible, Mode=OneWay, Converter={StaticResource VisibleIf}}"><TextBox Text="{Binding DiagnosticSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter the collected list as you type" AutomationProperties.Name="Search list"/></StackPanel><StackPanel Visibility="{Binding IsDeviceDiagnostic, Mode=OneWay, Converter={StaticResource VisibleIf}}"><WrapPanel><CheckBox Content="Only devices with problems" IsChecked="{Binding ProblemDevicesOnly, Mode=TwoWay}"/><Button Content="Device Manager" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="DeviceManager" /><Button Content="Manufacturer support" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Support" /></WrapPanel><DataGrid ItemsSource="{Binding DiagnosticRows, Mode=OneWay}" SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Height="330" MinRowHeight="36"><DataGrid.Columns><DataGridTextColumn Header="Device" Binding="{Binding Name, Mode=OneWay}" Width="250"/><DataGridTextColumn Header="Problem / explanation" Binding="{Binding Value, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Result" Binding="{Binding State, Mode=OneWay}" Width="130"/></DataGrid.Columns></DataGrid></StackPanel><StackPanel Visibility="{Binding IsSoftwareDiagnostic, Mode=OneWay, Converter={StaticResource VisibleIf}}"><WrapPanel><ComboBox Width="130" ItemsSource="{StaticResource InventoryScopes}" SelectedItem="{Binding InventoryScope, Mode=TwoWay}"/><Button Content="Uninstall selected…" Command="{Binding UninstallCommand, Mode=OneWay}" IsEnabled="{Binding CanUninstallSelected, Mode=OneWay}" ToolTip="Launch the selected application registered interactive uninstaller after confirmation"/><Button Content="CSV…" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="InventoryCsv" /><Button Content="JSON…" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="InventoryJson" /></WrapPanel><TextBlock Text="{Binding UninstallSelectionInfo, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding UninstallStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="#A8C0FF" Margin="0,4,0,10"/><DataGrid ItemsSource="{Binding InventoryRows, Mode=OneWay}" SelectedItem="{Binding SelectedInventory, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="350" MinRowHeight="36"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="250"/><DataGridTextColumn Header="Version" Binding="{Binding Version, Mode=OneWay}" Width="140"/><DataGridTextColumn Header="Publisher" Binding="{Binding Publisher, Mode=OneWay}" Width="200"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope, Mode=OneWay}" Width="100"/><DataGridTextColumn Header="Architecture" Binding="{Binding Architecture, Mode=OneWay}" Width="140"/></DataGrid.Columns></DataGrid></StackPanel><StackPanel Visibility="{Binding DiagnosticSearchVisible, Mode=OneWay, Converter={StaticResource VisibleIf}}"><Expander Header="Selected row details" Margin="0,10"><StackPanel><TextBox Text="{Binding DiagnosticDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto"/><WrapPanel><Button Content="Copy value" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="CopyValue" /><Button Content="Copy row" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="CopyRow" /></WrapPanel></StackPanel></Expander></StackPanel><StackPanel Visibility="{Binding IsCardDiagnostic, Mode=OneWay, Converter={StaticResource VisibleIf}}"><ItemsControl ItemsSource="{Binding DiagnosticGroups, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Items, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" TextWrapping="Wrap"/><TextBlock Text="{Binding State, Mode=OneWay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A9BEDB"/><Style.Triggers><DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Healthy"><Setter Property="Foreground" Value="#71D9A0"/></DataTrigger><DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Warning"><Setter Property="Foreground" Value="#F0C878"/></DataTrigger><DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Critical"><Setter Property="Foreground" Value="#FF9292"/></DataTrigger><DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Failed"><Setter Property="Foreground" Value="#FF9292"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Visibility="{Binding IsNetworkDiagnostic, Mode=OneWay, Converter={StaticResource VisibleIf}}"><Expander Header="Network tools and snapshot comparison"><StackPanel><ComboBox ItemsSource="{Binding AdapterChoices, Mode=OneWay}" SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"/><WrapPanel><Button Content="Refresh adapter list" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Adapters" /><Button Content="Save snapshot…" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="SaveSnapshot" /><Button Content="Load baseline…" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="LoadSnapshot" /><Button Content="Compare snapshots" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Compare" /><Button Content="Renew DHCP…" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Renew" /><Button Content="Release DHCP…" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Release" /><Button Content="Speedtest.net" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Speedtest" /><Button Content="Flush DNS…" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="DnsFlush" /></WrapPanel><TextBox Text="{Binding NetworkTarget, Mode=TwoWay}" ToolTip="Internet test target"/><Button Content="Test internet target" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Internet" /></StackPanel></Expander></StackPanel><StackPanel Visibility="{Binding IsUpdateDiagnostic, Mode=OneWay, Converter={StaticResource VisibleIf}}"><WrapPanel><Button Content="Scan available updates" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Scan" /><Button Content="Windows troubleshooters" Command="{Binding DiagnosticCommand, Mode=OneWay}" CommandParameter="Troubleshoot" /></WrapPanel></StackPanel><Expander Header="Technical evidence (optional)" Margin="0,12"><TextBox Text="{Binding DiagnosticTechnicalText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="280" VerticalScrollBarVisibility="Auto"/></Expander>
</StackPanel></DataTemplate>
  <x:Array x:Key="ServiceStates" Type="{x:Type sys:String}"><sys:String>All</sys:String><sys:String>Running</sys:String><sys:String>Stopped</sys:String></x:Array>
  <x:Array x:Key="EventLogs" Type="{x:Type sys:String}"><sys:String>System</sys:String><sys:String>Application</sys:String></x:Array>
  <x:Array x:Key="Severities" Type="{x:Type sys:String}"><sys:String>Both</sys:String><sys:String>Error</sys:String><sys:String>Warning</sys:String></x:Array>
