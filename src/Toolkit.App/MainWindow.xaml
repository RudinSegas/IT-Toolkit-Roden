  <DataTemplate x:Key="Field">
   <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Name, Mode=OneWay}" Style="{DynamicResource Muted}" FontSize="12"/><TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,3" Margin="0" TextWrapping="Wrap"/></StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="Dashboard">
   <StackPanel><DockPanel Margin="0,0,0,12"><Image Source="{DynamicResource AppLogo}" Width="40" Height="40" DockPanel.Dock="Left" Margin="0,0,12,0"/><TextBlock Text="IT Toolkit by Roden Segas" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"/></DockPanel>
    <WrapPanel><Button Content="Refresh inventory" Command="{Binding RefreshCommand, Mode=OneWay}"/><Button Content="Copy snapshot" Command="{Binding CopyInventoryCommand, Mode=OneWay}"/><Button Content="System information →" Command="{Binding NavigateCommand, Mode=OneWay}" CommandParameter="System Information"/></WrapPanel>
    <TextBlock Text="{Binding SnapshotStamp, Mode=OneWay}" Style="{DynamicResource Muted}" Margin="0,12,0,16"/>
    <ItemsControl ItemsSource="{Binding Cards, Mode=OneWay}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding Fields, Mode=OneWay}" ItemTemplate="{StaticResource Field}"/><ProgressBar Style="{DynamicResource UsageBar}" Height="9" Minimum="0" Maximum="100" Value="{Binding Usage, Mode=OneWay}" Visibility="{Binding HasUsage, Mode=OneWay, Converter={StaticResource VisibleIf}}"/></StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{Binding Warnings, Mode=OneWay}" Foreground="#F0C878" TextWrapping="Wrap"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="System">
   <StackPanel><WrapPanel><Button Content="Refresh inventory" Command="{Binding RefreshCommand, Mode=OneWay}"/><Button Content="Copy all information" Command="{Binding CopyInventoryCommand, Mode=OneWay}"/></WrapPanel><TextBlock Text="{Binding SnapshotStamp, Mode=OneWay}" Style="{DynamicResource Muted}" Margin="0,12,0,16"/>
    <ItemsControl ItemsSource="{Binding Sections, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/><ItemsControl ItemsSource="{Binding Fields, Mode=OneWay}" ItemTemplate="{StaticResource Field}"/><TextBlock Text="{Binding Warning, Mode=OneWay}" Foreground="#F0C878"/><Button Content="Copy section" HorizontalAlignment="Left" Command="{Binding DataContext.CopySectionCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Mode=OneWay}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="Network">
   <StackPanel IsEnabled="{Binding Idle, Mode=OneWay}">
    <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="On-demand network diagnostics" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="No domain membership is required. ICMP, TCP and name resolution test different things; a failed ping does not prove a host is offline." Style="{DynamicResource Muted}" Margin="0,10"/>
     <TextBlock Text="Hostname or IP address"/><TextBox Text="{Binding NetworkTarget, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" MaxLength="253" AutomationProperties.Name="Network target"/>
     <WrapPanel><StackPanel Width="160" Margin="0,0,16,0"><TextBlock Text="TCP port"/><TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" MaxLength="5"/></StackPanel><StackPanel Width="180"><TextBlock Text="Timeout per test (ms)"/><TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" MaxLength="5"/></StackPanel></WrapPanel>
     <WrapPanel><Button Content="Ping" Command="{Binding RunNetworkCommand, Mode=OneWay}" CommandParameter="Ping"/><Button Content="DNS lookup" Command="{Binding RunNetworkCommand, Mode=OneWay}" CommandParameter="Dns"/><Button Content="Reverse DNS" Command="{Binding RunNetworkCommand, Mode=OneWay}" CommandParameter="ReverseDns"/><Button Content="TCP port" Command="{Binding RunNetworkCommand, Mode=OneWay}" CommandParameter="Tcp"/><Button Content="Gateway test" Command="{Binding RunNetworkCommand, Mode=OneWay}" CommandParameter="Gateway"/><Button Content="Domain diagnostics" Command="{Binding RunNetworkCommand, Mode=OneWay}" CommandParameter="Domain"/><Button Content="Local configuration" Command="{Binding RunNetworkCommand, Mode=OneWay}" CommandParameter="Configuration"/></WrapPanel>
    </StackPanel></Border><TextBlock Text="Results appear in the operation output below. Copy or export them there. Domain tests return Not applicable on standalone computers." Style="{DynamicResource Muted}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="Services"><StackPanel>
<Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Windows Services" FontSize="23" FontWeight="SemiBold"/><WrapPanel><TextBox Width="280" Text="{Binding ServiceSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search services"/><ComboBox Width="160" ItemsSource="{StaticResource ServiceStates}" SelectedItem="{Binding ServiceStatus, Mode=TwoWay}"/><Button Content="Refresh services" Command="{Binding ServicesCommand, Mode=OneWay}" /></WrapPanel><TextBlock Text="{Binding ServiceListStatus, Mode=OneWay}" Style="{DynamicResource Muted}"/>
<DataGrid ItemsSource="{Binding ServiceRows, Mode=OneWay}" SelectedItem="{Binding SelectedService, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="300" MinRowHeight="34" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Display name" Binding="{Binding DisplayName, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Service name" Binding="{Binding Name, Mode=OneWay}" Width="200"/><DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="130"/><DataGridTextColumn Header="Startup type" Binding="{Binding Startup, Mode=OneWay}" Width="130"/></DataGrid.Columns></DataGrid>
<TextBlock Text="{Binding SelectedService.Name, Mode=OneWay}" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding SelectedService.Description, Mode=OneWay}" TextWrapping="Wrap"/><WrapPanel><Button Content="Start…" Command="{Binding ServiceActionCommand, Mode=OneWay}" CommandParameter="StartService" IsEnabled="{Binding CanStartService, Mode=OneWay}"/><Button Content="Stop…" Command="{Binding ServiceActionCommand, Mode=OneWay}" CommandParameter="StopService" IsEnabled="{Binding CanStopService, Mode=OneWay}"/><Button Content="Restart…" Command="{Binding ServiceActionCommand, Mode=OneWay}" CommandParameter="RestartService" IsEnabled="{Binding CanRestartService, Mode=OneWay}"/></WrapPanel><TextBlock Text="{Binding ServiceActionStatus, Mode=OneWay}" Foreground="#F0C878" TextWrapping="Wrap"/>
</StackPanel></Border>
<Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Windows Event Logs" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Read one selected log at a time. Event details may contain sensitive information." Style="{DynamicResource Muted}" Margin="0,8"/>
<ComboBox ItemsSource="{Binding AvailableEventLogs, Mode=OneWay}" SelectedItem="{Binding EventLog, Mode=TwoWay}" AutomationProperties.Name="Event log"/><WrapPanel><StackPanel Width="140"><TextBlock Text="Severity"/><ComboBox ItemsSource="{Binding AvailableEventSeverities, Mode=OneWay}" SelectedItem="{Binding EventSeverity, Mode=TwoWay}"/></StackPanel><StackPanel Width="100" Margin="10,0,0,0"><TextBlock Text="Days (1–30)"/><TextBox Text="{Binding EventDays, Mode=TwoWay}"/></StackPanel><StackPanel Width="130" Margin="10,0,0,0"><TextBlock Text="Page size (1–500)"/><TextBox Text="{Binding EventMaximum, Mode=TwoWay}"/></StackPanel><StackPanel Width="140" Margin="10,0,0,0"><TextBlock Text="Event ID (optional)"/><TextBox Text="{Binding EventIdFilter, Mode=TwoWay}"/></StackPanel><StackPanel Width="230" Margin="10,0,0,0"><TextBlock Text="Exact source (optional)"/><TextBox Text="{Binding EventSourceFilter, Mode=TwoWay}"/></StackPanel></WrapPanel><WrapPanel><Button Content="Load events" Command="{Binding EventsCommand, Mode=OneWay}" /><Button Content="Older events →" Command="{Binding NextEventsCommand, Mode=OneWay}" /></WrapPanel><TextBlock Text="{Binding EventListStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="#F0C878"/>
<DataGrid ItemsSource="{Binding EventRows, Mode=OneWay}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="320" MinRowHeight="34" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Date / time" Binding="{Binding Time, Mode=OneWay}" Width="160"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity, Mode=OneWay}" Width="100"/><DataGridTextColumn Header="Source" Binding="{Binding Source, Mode=OneWay}" Width="200"/><DataGridTextColumn Header="Event ID" Binding="{Binding Id, Mode=OneWay}" Width="90"/><DataGridTextColumn Header="Description" Binding="{Binding ShortDescription, Mode=OneWay}" Width="350"/></DataGrid.Columns></DataGrid>
<TextBlock Text="Full event details" FontWeight="SemiBold" Margin="0,12"/><TextBox Text="{Binding EventDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="240" VerticalScrollBarVisibility="Auto"/><Button Content="Copy full event" Command="{Binding CopyEventCommand, Mode=OneWay}" /></StackPanel></Border></StackPanel></DataTemplate>
  <DataTemplate x:Key="Maintenance">
   <StackPanel IsEnabled="{Binding Idle, Mode=OneWay}">
    <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="System Health &amp; Repair" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Administrator operations ask for confirmation and native UAC. Progress is measured from command output; indeterminate means no numeric progress is available. Active servicing is never forcibly killed." Style="{DynamicResource Muted}" Margin="0,10"/>
     <WrapPanel><Button Content="Enable .NET Framework 3.5" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="NetFx3"/><Button Content="Flush DNS" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="DnsFlush"/><Button Content="SFC /scannow" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="Sfc"/><Button Content="DISM CheckHealth" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="DismCheck"/><Button Content="DISM ScanHealth" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="DismScan"/><Button Content="DISM RestoreHealth" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="DismRestore"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Group Policy" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Opens a visible Command Prompt running gpupdate /force under the current application user. The window stays open so you can read progress and answer Windows prompts manually. No automatic restart/logoff or completion claim." Style="{DynamicResource Muted}" Margin="0,10"/><WrapPanel><Button Content="Refresh Group Policy" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="GpUpdate"/><Button Content="GPResult · current user" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="ResultUser"/><Button Content="GPResult · computer (UAC)" Command="{Binding MaintenanceCommand, Mode=OneWay}" CommandParameter="ResultComputer"/></WrapPanel></StackPanel></Border>
    <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Remote GPUpdate" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Optional enterprise capability. Requires Group Policy RSAT, authorized Windows identity and existing remote RPC/WMI/Task Scheduler access. IP addresses require confirmed name resolution. No firewall, WinRM or authentication changes are made." Style="{DynamicResource Muted}" Margin="0,10"/><CheckBox Content="Enable authorized enterprise operations for this session" IsChecked="{Binding EnterpriseEnabled, Mode=TwoWay}" Margin="0,6,0,12"/><TextBlock Text="Computer hostname, FQDN or IP"/><TextBox Text="{Binding RemoteTarget, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" MaxLength="253"/><Button Content="Review / request remote refresh" HorizontalAlignment="Left" Command="{Binding RemoteCommand, Mode=OneWay}"/></StackPanel></Border>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="Updates">
   <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Native Windows Update" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Windows handles detection, download, installation and restarts. Existing WSUS, Windows Update for Business and Intune policies remain in effect." Style="{DynamicResource Muted}" Margin="0,14"/><WrapPanel><Button Content="Open Windows Update" Command="{Binding SettingsCommand, Mode=OneWay}" CommandParameter="Open"/><Button Content="Check for Updates (Settings action)" Command="{Binding SettingsCommand, Mode=OneWay}" CommandParameter="Check"/><Button Content="Lenovo System Update" Command="{Binding SettingsCommand, Mode=OneWay}" CommandParameter="Lenovo" /><Button Content="Dell Command | Update Classic" Command="{Binding SettingsCommand, Mode=OneWay}" CommandParameter="Dell" /></WrapPanel><TextBlock Text="Opening Settings does not establish that a scan or installation completed. If this Windows build ignores the action URI, use Open Windows Update. The toolkit contains no update installation engine." Margin="0,14" Style="{DynamicResource Muted}"/></StackPanel></Border>
  </DataTemplate>
  <DataTemplate x:Key="Software">
   <StackPanel IsEnabled="{Binding Idle, Mode=OneWay}">
    <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Online software installation" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Official direct installers are primary; WinGet is optional. Choose Java explicitly. Downloads require trusted origins, integrity/publisher verification and post-install evidence. Unsupported vendor metadata fails closed. Machine installers request UAC; VS Code uses current-user scope." Style="{DynamicResource Muted}" Margin="0,10"/>
     <TextBlock Text="Installation provider (no automatic switching)"/><ComboBox ItemsSource="{StaticResource Providers}" SelectedItem="{Binding SoftwareProvider, Mode=TwoWay}"/><WrapPanel><Button Content="Refresh installed status" Command="{Binding SoftwareCommand, Mode=OneWay}" CommandParameter="Refresh"/><Button Content="Detect WinGet" Command="{Binding SoftwareCommand, Mode=OneWay}" CommandParameter="Detect"/><Button Content="Install / repair WinGet (Store)" Command="{Binding SoftwareCommand, Mode=OneWay}" CommandParameter="Repair"/></WrapPanel>
     <DataGrid ItemsSource="{Binding Packages, Mode=OneWay}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" MinHeight="280" MaxHeight="450" Margin="0,15" Background="#101727" Foreground="#E9EEF8" RowBackground="#181F30" AlternatingRowBackground="#202D44" EnableRowVirtualization="True">
      <DataGrid.Columns><DataGridCheckBoxColumn Header="Select" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/><DataGridTextColumn Header="Application" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="220"/><DataGridTextColumn Header="Exact package ID" Binding="{Binding Id, Mode=OneWay}" IsReadOnly="True" Width="240"/><DataGridTextColumn Header="Installed / last result" Binding="{Binding State, Mode=OneWay}" IsReadOnly="True" Width="300"/><DataGridTextColumn Header="Available version" Binding="{Binding AvailableVersion, Mode=OneWay}" IsReadOnly="True" Width="200"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="Scope: default uses the catalog's supported installer scope; user/machine requests may be unsupported by some packages." Style="{DynamicResource Muted}"/><ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{StaticResource Scopes}" SelectedItem="{Binding InstallScope, Mode=TwoWay}"/>
     <WrapPanel><Button Content="Install selected…" Command="{Binding SoftwareCommand, Mode=OneWay}" CommandParameter="Install"/><Button Content="Update selected…" Command="{Binding SoftwareCommand, Mode=OneWay}" CommandParameter="Update"/><Button Content="Package details / terms" Command="{Binding SoftwareCommand, Mode=OneWay}" CommandParameter="Details"/><Button Content="Official page for selected row" Command="{Binding SoftwareCommand, Mode=OneWay}" CommandParameter="Vendor"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Official vendor fallback" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Official direct is the primary catalog provider above. Vendor pages remain available when metadata or distribution permissions are unavailable. The VS Code shortcut below retains the current-user installation workflow. Security failures never switch providers automatically." Style="{DynamicResource Muted}" Margin="0,10"/><Button Content="Review direct VS Code download / install…" HorizontalAlignment="Left" Command="{Binding SoftwareCommand, Mode=OneWay}" CommandParameter="Direct"/></StackPanel></Border>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="Reports">
   <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="Reports &amp; logs" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Export the inventory and completed operation summaries as an offline HTML report. Explicit text export includes the retained command/diagnostic output. Device names, account names, IPs and event messages can be sensitive; review before sharing." Style="{DynamicResource Muted}" Margin="0,14"/><WrapPanel><Button Content="Export HTML report…" Command="{Binding ReportCommand, Mode=OneWay}" CommandParameter="HTML"/><Button Content="Export current output…" Command="{Binding ExportTextCommand, Mode=OneWay}"/><Button Content="Copy current output" Command="{Binding CopyOutputCommand, Mode=OneWay}"/></WrapPanel><CheckBox Content="Redact identifying information (recommended)" IsChecked="{Binding RedactReports, Mode=TwoWay}" Margin="0,12"/><ItemsControl ItemsSource="{Binding ReportSections, Mode=OneWay}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name, Mode=OneWay}" IsChecked="{Binding Included, Mode=TwoWay}" Margin="0,8,18,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel><Button Content="Export selected HTML…" Command="{Binding ReportCommand, Mode=OneWay}" CommandParameter="HTML"/><Button Content="Export selected JSON…" Command="{Binding ReportCommand, Mode=OneWay}" CommandParameter="JSON"/></WrapPanel><TextBlock Text="Structured session log" FontWeight="SemiBold" Margin="0,16,0,5"/><TextBox Text="{Binding LogPath, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="{Binding LogStatus, Mode=OneWay}" Foreground="#F0C878"/></StackPanel></Border>
  </DataTemplate>
  <DataTemplate x:Key="About">
   <Border Style="{DynamicResource Card}"><StackPanel><Image Source="{DynamicResource AppLogo}" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock Text="IT Toolkit by Roden Segas v1.0.0" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Copyright © 2026 Roden Segas. All rights reserved."/><TextBlock Text="Prior code license notices and third-party obligations are preserved separately in docs/LICENSE and docs/THIRD-PARTY-NOTICES.md." TextWrapping="Wrap" Style="{DynamicResource Muted}" Margin="0,8"/><TextBlock Text="Native C# · WPF · .NET Framework 4.8 · Windows x64 · MVVM" Foreground="#A8C0FF" Margin="0,12"/><TextBlock Text="Implemented: inventory, network diagnostics, services/events, allowlisted maintenance, GPResult, optional authorized remote GPUpdate, native Update Settings, online software providers and reporting. No PowerShell GUI, organization-specific deployment or embedded command console." Style="{DynamicResource Muted}" Margin="0,8"/><TextBlock Text="The native read-only privilege probe checks the actual elevated helper token and authenticated local channel. It performs no repair or installation. Starting the toolkit normally never asks for UAC." Margin="0,12"/><Button Content="Create my desktop shortcut…" Command="{Binding CreateShortcutCommand, Mode=OneWay}" HorizontalAlignment="Left"/><Button Content="Review / run administrator helper probe…" Command="{Binding ProbeCommand, Mode=OneWay}" HorizontalAlignment="Left"/><TextBlock Text="Unsigned builds may be restricted by application control. The toolkit does not change security policies. Checksums establish integrity, not publisher trust. Native Windows GUI/UAC/installation acceptance must be performed on Windows; see the included test report." Style="{DynamicResource Muted}" Margin="0,16"/><TextBlock Text="Deferred by design: PC Setup Wizard, advanced Office deployment/removal and interactive console. These are not exposed as operational features." Style="{DynamicResource Muted}" Margin="0,10"/></StackPanel></Border>
