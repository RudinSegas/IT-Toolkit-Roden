<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Accent" Color="#739BFF"/>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#B2BED2"/><Setter Property="FontSize" Value="14"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#181F30"/><Setter Property="BorderBrush" Value="#2A344A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="Background" Value="#27344F"/><Setter Property="BorderBrush" Value="#3C4E6D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,3,8,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#354968"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A8C0FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#B2BED2"/><Setter Property="GroupName" Value="Navigation"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1B263B"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#253657"/><Setter Property="Foreground" Value="#DDE8FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#739BFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#101727"/><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3C4E6D"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,6,0,14"/></Style>

 <Style x:Key="UsageBar" TargetType="ProgressBar"><Setter Property="Foreground" Value="#739BFF"/><Setter Property="Background" Value="#2A344A"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/></Grid></ControlTemplate></Setter.Value></Setter></Style>

 <Style TargetType="TabControl"><Setter Property="Background" Value="#101727"/><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="BorderBrush" Value="#3C4E6D"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel><TabPanel DockPanel.Dock="Top" IsItemsHost="True" Background="#181F30"/><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B2BED2"/><Setter Property="Padding" Value="14,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="#202D44" Padding="{TemplateBinding Padding}" Margin="0,0,4,0" CornerRadius="5,5,0,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#354968"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#A8C0FF"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="Background" Value="#182237"/><Setter Property="Margin" Value="0,8"/></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="Background" Value="#202D44"/><Setter Property="Padding" Value="10,8"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="Background" Value="#202D44"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="#3C4E6D" BorderThickness="1" Padding="12,8"><DockPanel><TextBlock Text="▾" DockPanel.Dock="Right" Margin="20,0,0,0"/><ContentPresenter/></DockPanel></Border></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" HorizontalAlignment="Left"/></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#202D44" BorderBrush="#3C4E6D" BorderThickness="1" MinWidth="180"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="Padding" Value="7"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#354968"/></Trigger></Style.Triggers></Style>
 <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#E9EEF8"/></Style>
<Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#739BFF"/><Setter Property="Background" Value="#293A56"/></Style>

 <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,13"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#739BFF"/></Trigger><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Mode="OneWay" Converter="{StaticResource NavSelection}"><Binding Mode="OneWay" Path="CurrentPage"/><Binding Mode="OneWay" Path="CommandParameter" RelativeSource="{RelativeSource Self}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="#253657"/><Setter Property="Foreground" Value="#DDE8FF"/></DataTrigger></Style.Triggers></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293A56"/><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="#101727"/><Setter Property="Foreground" Value="#E9EEF8"/><Setter Property="RowBackground" Value="#181F30"/><Setter Property="AlternatingRowBackground" Value="#202D44"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderBrush" Value="#3C4E6D"/></Style>
</ResourceDictionary>